#Chance (0.0 - 1.0) that skipping the night traps the server in a dream.
# Default: 0.5
# Range: 0.0 ~ 1.0
dreamChance = 0.9
#Minimum dream duration in seconds. Each dream picks a random value in [min, max].
# Default: 300
# Range: 1 ~ 36000
dreamMinSeconds = 100
#Maximum dream duration in seconds.
# Default: 1200
# Range: 1 ~ 36000
dreamMaxSeconds = 100
#If true, dying wakes the dream when all online players die at the same time (in single player, just the player dying).
wakeOnDeath = true
